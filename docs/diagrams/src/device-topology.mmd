%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Microsoft YaHei, Segoe UI, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#ffffff",
    "primaryBorderColor": "#37474f",
    "lineColor": "#546e7a",
    "tertiaryColor": "#f5f7f8"
  },
  "flowchart": {"curve": "basis", "nodeSpacing": 24, "rankSpacing": 40, "htmlLabels": false}
}}%%
flowchart LR
  PC["PC<br/>烧录 / 采集同步 / 训练"]
  MCU["ESP32-S3<br/>N16R8"]

  subgraph PER["板载 / 外设"]
    MEM["16 MB Flash<br/>8 MB Octal PSRAM"]
    USB["CH343P<br/>USB-UART<br/>GPIO43/44"]
    EPD["SSD1619A<br/>400×300 单色<br/>SCK12 / MOSI11<br/>CS10 / DC9 / RST8 / BUSY7"]
    KEY["5 键<br/>PREV / NEXT<br/>PLAY / RECORD<br/>SYNC<br/>GPIO1/4/5/6/13"]
    MIC["MS4030<br/>I2S0 麦克风<br/>BCLK14 / WS15 / SD16<br/>PWR gate 38"]
    AMP["MAX98357A<br/>I2S1 功放<br/>BCLK17<br/>LRC18<br/>DIN21<br/>SD47"]
    SPK["3 W / 4 Ω<br/>差分喇叭"]
    INA["INA219<br/>I²C 电流计<br/>（计划）"]
    BAT["电池分压<br/>GPIO2 ADC<br/>（计划）"]
  end

  PC <-->|USB| USB
  USB <-->|UART| MCU
  MCU --- MEM
  MCU -->|SPI2| EPD
  MCU ---|GPIO| KEY
  MCU -->|I2S0| MIC
  MCU -->|I2S1| AMP
  AMP -->|+/-| SPK
  MCU <-->|I2C| INA
  MCU ---|ADC| BAT

  classDef core fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20,stroke-width:1.5px
  classDef io fill:#e3f2fd,stroke:#1565c0,color:#0d47a1,stroke-width:1.5px
  classDef planned fill:#fff8e1,stroke:#f9a825,color:#e65100,stroke-dasharray:6 4,stroke-width:1.5px
  class MCU,MEM,USB core
  class EPD,KEY,MIC,AMP,SPK io
  class INA,BAT planned
